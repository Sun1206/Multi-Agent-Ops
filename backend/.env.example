MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_ops
MYSQL_TEST_DATABASE=ai_ops_test
MYSQL_USER=ai_ops
MYSQL_PASSWORD=
AIOPS_DATABASE_MODE=development
AIOPS_ADMIN_INITIAL_PASSWORD=
AIOPS_CONFIG_ENCRYPTION_KEY=
AIOPS_MODEL_ALLOWED_INTERNAL_ORIGINS=[]
AIOPS_MCP_ALLOWED_INTERNAL_ORIGINS=[]
AIOPS_METRIC_ALLOWED_ORIGINS=[]
# Grafana面板API的内网地址白名单，按需填写实际HTTP(S)源地址。
AIOPS_GRAFANA_ALLOWED_ORIGINS=[]
AIOPS_LOG_ALLOWED_ORIGINS=[]
# 通知Webhook内网源白名单，公网HTTPS无需额外授权；禁止跳转和系统代理。
AIOPS_ALERT_ALLOWED_ORIGINS=[]
# 邮件渠道使用服务端SMTP配置，生产环境建议启用STARTTLS或SSL。
AIOPS_SMTP_HOST=
AIOPS_SMTP_PORT=587
AIOPS_SMTP_FROM=
AIOPS_SMTP_USERNAME=
AIOPS_SMTP_PASSWORD=
AIOPS_SMTP_SSL=false
AIOPS_SMTP_STARTTLS=true
